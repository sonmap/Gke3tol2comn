# Reviewer note: envsubst renders FILESTORE_IP, NFS_EXPORT, TEST_IMAGE.
# 2026-10-22 attached example: RSVP, 20Gi ROX, CPU 4 / Memory 16Gi / GPU 0.
# For FIRST RSVP smoke only; confirm NFS_SERVER is a genuine Filestore IP, NOT MGMT VM.
# Test NFS export must contain GP_L2RSVP_001_1/python/sample_bq.py and .oefj.
# Do not apply until image exists and FILESTORE_IP + NFS_EXPORT are approved.
apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-rsvp-bq-smoke
spec:
  capacity:
    storage: 20Gi
  accessModes:
    - ReadOnlyMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  nfs:
    server: ${FILESTORE_IP}
    path: ${NFS_EXPORT}
    readOnly: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-rsvp-bq-smoke
  namespace: l2comm-batch
spec:
  accessModes:
    - ReadOnlyMany
  volumeName: pv-rsvp-bq-smoke
  storageClassName: ""
  resources:
    requests:
      storage: 20Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: rsvp-bq-smoke
  namespace: l2comm-batch
  labels:
    app: rsvp-bq-smoke
    purpose: pre-cutover
spec:
  restartPolicy: Never
  serviceAccountName: ksa-l2comm-batch
  containers:
    - name: bq-smoke
      image: ${TEST_IMAGE}
      imagePullPolicy: Always
      command:
        - /bin/sh
        - -ec
      args:
        - python /home/jupyter/GP_L2RSVP_001_1/python/sample_bq.py
      env:
        - name: BQ_KEY_PATH
          value: /home/jupyter/.oefj
        - name: PYTHONUNBUFFERED
          value: "1"
      resources:
        requests:
          cpu: "4"
          memory: "16Gi"
        limits:
          cpu: "4"
          memory: "16Gi"
      volumeMounts:
        - name: rsvp-share
          mountPath: /home/jupyter
          readOnly: true
  volumes:
    - name: rsvp-share
      persistentVolumeClaim:
        claimName: pvc-rsvp-bq-smoke
